<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hey ya'll</title>
    <script src="/scripts/theme.js"></script>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="sun-icon" aria-hidden="true">☀</span>
        <span class="moon-icon" aria-hidden="true">☾</span>
    </button>
    <div class="index-parent-div rainbow-panel">
        <% if (locals.user) { %>
            <h1 class="index-main-heading">Logged in as <span class="username"><%= user.username %></span></h1>
            <div class="index-actions">
                <a href="/folders"><button>Your drive</button></a>
                <a href="/logout"><button id="index-logout-button">Log Out</button></a>
            </div>
            <section class="index-stats" aria-label="Account statistics">
                <div class="stat-card">
                    <strong><%= stats.fileCount %></strong>
                    <span>Files</span>
                </div>
                <div class="stat-card">
                    <strong><%= stats.folderCount %></strong>
                    <span>Folders</span>
                </div>
                <div class="stat-card stat-card-wide">
                    <strong><%= stats.lastLogin %></strong>
                    <span>Last logged in</span>
                </div>
            </section>
        <% } else { %>
            <h1>File Uploader</h1>
            <a href="/login"><button>Login</button></a>
            <a href="/signup"><button>Signup</button></a>
        <% } %>
    </div>
</body>
</html>