<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Drive</title>
    <script src="/scripts/theme.js"></script>
    <!-- Modern font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/styles/style.css">

</head>
<body>
    <nav class="top-nav" aria-label="Main navigation">
        <a class="home-link" href="/">Home</a>
        <div class="top-nav-actions">
            <a class="logout-link" href="/logout">Log out</a>
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
                <span class="sun-icon" aria-hidden="true">☀</span>
                <span class="moon-icon" aria-hidden="true">☾</span>
            </button>
        </div>
    </nav>
    <main class="folders-page-panel rainbow-panel" data-folder-id="<%= currentFolderId ?? '' %>">
    <h1><span class="drive-owner"><%= user.username %></span>&rsquo;s Drive</h1>

    <hr />

    <div class="section-heading">
        <h3>Folders</h3>
    </div>
    <div class="action-toolbar">
        <div class="action-form upload-form">
            <input id="file-picker" type="file" name="uploaded_file" multiple hidden>
            <button id="file-upload-submit" type="button">Upload file</button>
        </div>
        <form action="/folders/new-folder" method="POST" class="action-form new-folder-form">
            <input type="hidden" name="parentId" value="<%= currentFolderId ?? '' %>">
            <input type="text" name="name" placeholder="New folder name" aria-label="New folder name" required>
            <button type="submit" class="new-folder-button">New folder</button>
        </form>
    </div>

    <div id="drop-overlay" class="drop-overlay" aria-hidden="true">
        <div class="drop-message">
            <strong>Drop files or folders to upload</strong>
            <span>They will be added to this folder.</span>
        </div>
    </div>

    <div id="upload-confirmation" class="upload-dialog" role="dialog" aria-modal="true" aria-labelledby="upload-dialog-title" hidden>
        <div class="upload-dialog-content">
            <h2 id="upload-dialog-title">Upload these items?</h2>
            <p id="upload-summary"></p>
            <div id="upload-file-list" class="upload-file-list"></div>
            <div class="dialog-actions">
                <button id="cancel-upload" type="button" class="secondary-button">Cancel</button>
                <button id="confirm-upload" type="button">Upload</button>
            </div>
        </div>
    </div>
    <% if (breadcrumbs.length > 0) { %>
    <nav class="breadcrumbs">
        <br>
        <a href="/folders">Root</a>

        <% breadcrumbs.forEach((crumb, index) => { %>
            <span> / </span>
            <% if (index === breadcrumbs.length - 1) { %>
                <strong><%= crumb.name %></strong>
            <% } else { %>
                <a href="/folders?folderId=<%= crumb.id %>"><%= crumb.name %></a>
            <% } %>
        <% }) %>

    </nav>
    <% } %>
    <br>
    <div class="folder-grid">
    <% if (folders.length === 0) { %>
        <p>No subfolders here.</p>
    <% } %>
    <% folders.forEach(folder => { %>
        <div class="folder-card item-node"
             data-type="folders"
             data-id="<%= folder.id %>"
             data-name="<%= folder.name %>">
            <a href="/folders?folderId=<%= folder.id %>">
                📁 <%= folder.name %>
            </a>
            <button class="menu-btn" title="More actions">⋮</button>
        </div>
    <% }) %>
    </div>

    <hr />

    <!-- Files List -->
    <h3>Files</h3>
    <div class="file-grid">
    <% if (files.length === 0) { %>
        <p>No files in this folder.</p>
    <% } %>
    <% files.forEach(file => { %>
        <div class="file-card item-node" 
             data-type="files" 
             data-id="<%= file.id %>" 
             data-name="<%= file.name %>">
            <span>📄 <a href="<%= file.link %>" target="_blank"><%= file.name %> | <%= (file.size / 1024 / 1024).toFixed(2) %> MB | Uploaded: <%= new Date(file.dateUploaded).toLocaleDateString('en-US') %></a></span>
            <button class="menu-btn" title="More actions">⋮</button>
        </div>
    <% }) %>
    </div>

    <!-- Reusable Context Menu -->
    <div id="context-menu" class="context-menu">
        <ul>
            <li>
                <button id="menu-rename">✏️ Rename</button>
            </li>
            <hr />
            <li>
                <button id="menu-delete" class="danger">🗑️ Delete</button>
            </li>
        </ul>
    </div>
    </main>

    <script src="/scripts/folders.js"></script>
</body>
</html>